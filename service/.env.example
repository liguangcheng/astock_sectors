# 复制为 .env 后按需修改；不提交真实密码
ASTOCK_HOST=127.0.0.1
ASTOCK_PORT=3999

# 阶段一：SQLite 单文件（默认）
# ASTOCK_DATABASE_URL=sqlite:///C:/path/to/service/data/astock.db

# 阶段二：MySQL（容器映射 3307，避免与本机 3306 冲突）
# ASTOCK_DATABASE_URL=mysql+pymysql://astock:change-me@127.0.0.1:3307/astock?charset=utf8mb4

# 维护接口令牌
ASTOCK_ADMIN_TOKEN=local-dev-token

# 归一化基期与同步起点
ASTOCK_BASE_MONTH=2023-12
ASTOCK_SEED_FROM=2023-12-01

# 开发态前端（5173）跨域白名单
ASTOCK_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
